@model DevOpsAssetWeb.Models.Asset

@{
    ViewData["Title"] = "Edit Asset";
}

<div class="container mt-4">
    <h1>Edit Asset</h1>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="IPAddress" class="form-label"></label>
            <input asp-for="IPAddress" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Environment" class="form-label"></label>
            <input asp-for="Environment" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <input asp-for="Status" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>